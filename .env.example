# ==============================================================================
# SALESFORCE PARTNERSHIP PAYMENT MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit .env.local or real production credentials into source control.
# ==============================================================================

# ==============================================================================
# SECTION 1: REQUIRED IN PRODUCTION (Add these in Vercel Project Settings -> Environment Variables)
# ==============================================================================

# Supabase Project Base URL
# Obtain from Supabase Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Client-Side Publishable Key (Modern format: sb_publishable_...)
# Safe to expose in browser bundles; governed by PostgreSQL Row-Level Security (RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-Side Secret Key (Modern format: sb_secret_...)
# CRITICAL SECURITY RULE: Strictly server-side only. NEVER prefix with NEXT_PUBLIC_!
SUPABASE_SECRET_KEY=sb_secret_your_key_here


# ==============================================================================
# SECTION 2: OPTIONAL BACKWARD-COMPATIBILITY FALLBACKS (Legacy Supabase JWT Keys)
# Only needed if your Supabase project uses legacy JWT keys instead of the modern sb_ keys.
# If modern keys (Section 1) are set, these fallbacks are completely unneeded.
# ==============================================================================

# Legacy public anon key fallback
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Legacy secret service_role key fallback
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side alias fallback for project URL
# SUPABASE_URL=https://your-project-ref.supabase.co


# ==============================================================================
# SECTION 3: LOCAL DEVELOPMENT ONLY (Do NOT set in Vercel)
# ==============================================================================

# Application Base URL for local testing (Optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development environment indicator
NODE_ENV=development


# ==============================================================================
# SECTION 4: MANAGED AUTOMATICALLY BY VERCEL & NEXT.JS (DO NOT SET MANUALLY)
# ==============================================================================
# - NODE_ENV: Vercel automatically sets this to 'production' in production deployments.
# - NEXT_PHASE: Next.js automatically sets this internally during build/runtime phases.
# - VERCEL_*: Injected automatically by Vercel platform runtime.

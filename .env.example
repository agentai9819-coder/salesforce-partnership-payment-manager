# ==============================================================================
# SALESFORCE PARTNERSHIP PAYMENT MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# DO NOT commit .env.local or real production credentials into source control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & API Configuration
# Obtain from Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 1. CLIENT-SIDE PUBLISHABLE KEY (Safe for browser / client components)
# Modern format starts with: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy format fallback (optional):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. SERVER-SIDE SECRET KEY (STRICTLY SERVER-ONLY)
# Modern format starts with: sb_secret_...
# SECURITY CRITICAL: NEVER prefix with NEXT_PUBLIC_! NEVER expose in client bundles!
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Legacy format fallback (optional):
SUPABASE_SERVICE_ROLE_KEY=

# Runtime Environment
NODE_ENV=development

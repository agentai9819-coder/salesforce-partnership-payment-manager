# ==============================================================================
# SALESFORCE PARTNERSHIP PAYMENT MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# DO NOT commit .env.local or real production credentials into source control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Managed Database & Auth Configuration
# Obtain from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Supabase Server-Side Secret Key (Required for administrative scripts / seed only)
# NEVER expose this key in client-side code or browser bundles!
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-here

# Runtime Environment
NODE_ENV=development
